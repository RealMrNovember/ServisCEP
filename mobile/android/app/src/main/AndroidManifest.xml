<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Ag erisimi: Google Sign-In, guncelleme kontrolu, gelecekteki API -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- connectivity_plus kendi manifestinde bu izni beyan ediyor ve merge
         sirasinda normalde eklenir; ACIKCA yaziliyor cunku bu izin merge
         edilmezse baglanti dinleyicisi hic yayin yapmaz ve "internet gelince
         otomatik esitle" davranisi sessizce olur. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- image_picker paketi bu izinleri manifest merge sirasinda otomatik
         ekliyor, ama uygulama SADECE ImageSource.camera kullaniyor (bkz.
         job_detail_screen.dart) — galeriye/videoya hic erisilmiyor. Play
         Console'un "Fotograf ve Video Izinleri" politika beyani gerektirmemesi
         icin (kullanilmayan bir izin icin gerekce yazmak yerine) izinler
         kaynagindan kaldiriliyor. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
    <!-- Barkod tarama (mobile_scanner) ve iş/servis fotoğrafları için -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <!-- Yerel hatirlatma bildirimleri (flutter_local_notifications) - docs/05.
         Kasitli olarak "exact alarm" izni istenmiyor (INEXACT scheduling
         kullaniliyor), boylece kullaniciya ekstra izin ekrani cikmiyor. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- android.permission.REQUEST_INSTALL_PACKAGES BURADA DEĞİL — yalnızca
         "github" flavor'ında (src/github/AndroidManifest.xml) eklenir. Play
         Store sürümü bu izne ihtiyaç duymaz (resmi Play In-App Update API'si
         kullanılır) ve Play Console'un ayrı bir izin beyanı istememesi için
         Play flavor'ının manifestinde bu izin kasıtlı olarak bulunmaz. -->
    <!--
      allowBackup KAPALI.

      Açıkken Android Auto Backup, uygulama silinip kurulduğunda şifreli
      güvenli depoyu (flutter_secure_storage) geri yüklüyor ama onu açan
      Keystore anahtarını geri yüklemiyor. Sonuç: hiçbir zaman çözülemeyecek
      bir veri ve her okumada hata. Bu hata, isteğin hiç atılamamasına ve
      kullanıcıya "internet bağlantısı gerekli" denmesine yol açtı; cihazın
      verisi elle temizlenene kadar da geçmiyordu.

      Yedeklemeden vazgeçmenin maliyeti yok: tüm veri sunucuyla eşitleniyor,
      cihazdaki veritabanı yalnızca bir önbellek. Kullanıcı yeniden kurup
      giriş yaptığında her şey geri geliyor.
    -->
    <application
        android:label="TeknikCEP"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications: zamanlanmis bildirimlerin
             gosterilebilmesi ve cihaz yeniden baslatildiginda yeniden
             zamanlanabilmesi icin gerekli (docs/05). -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Sunucudan gelen (FCM) bildirimlerin simgesi ve rengi.
             Belirtilmezse Android renkli launcher ikonuna düşer ve
             yalnızca alfa kanalını kullandığı için simge tanınmaz bir
             leke olarak görünür (bkz. res/drawable/ic_notification.xml). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
